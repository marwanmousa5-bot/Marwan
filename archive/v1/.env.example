# ---------------------------------------------------------------------------
# FleetBeat - copy to .env and adjust. Nothing here is baked into the image.
# ---------------------------------------------------------------------------

# --- Application ---
ENVIRONMENT=local
DEBUG=true
APP_NAME=FleetBeat API

# --- Database ---
POSTGRES_USER=fleetbeat
POSTGRES_PASSWORD=fleetbeat
POSTGRES_DB=fleetbeat
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://fleetbeat:fleetbeat@db:5432/fleetbeat

# --- Redis / Celery ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ACTIVATION_TOKEN_EXPIRE_HOURS=72

# --- Frontend ---
WEB_APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Platform super admin seed (Section 4a) ---
# Leave SUPERADMIN_INITIAL_PASSWORD unset to have a random password generated
# and printed to the API container logs exactly once on first startup.
SUPERADMIN_EMAIL=Marwan.mousa5@gmail.com
SUPERADMIN_NAME=FleetBeat Platform Admin
# SUPERADMIN_INITIAL_PASSWORD=

# --- Demo data (optional, for evaluation and testing) ---
# `docker compose run --rm api python -m app.seed_demo` builds a populated
# tenant so a fresh stack has something to show. Leave the password unset to
# have one generated and printed once.
# DEMO_ADMIN_PASSWORD=

# --- Routing engine (OSRM, Section 3) ---
OSRM_BASE_URL=http://osrm:5000
OSRM_REGION=region

# --- Weather (Open-Meteo needs no API key) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- Claude API (AI layer, Section 5) ---
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- GPS simulation engine (Section 6) ---
# The simulator only produces data for vehicles that have an ACTIVE GPS
# device assigned in the Platform Admin Console. Everything else shows as
# "Not Tracked" to the customer.
SIMULATION_ENABLED=true
SIMULATION_TICK_SECONDS=3
# Chance per vehicle per tick of a harsh-braking / acceleration / speeding
# event. At a 3s tick and ~50 km/h this default works out to roughly 3.6
# events per 100 km - realistic for a mixed fleet, and what the safety score
# is calibrated against. Raise it to generate behaviour data faster for a
# demo, but expect scores to fall accordingly.
SIMULATION_EVENT_PROBABILITY=0.0015
